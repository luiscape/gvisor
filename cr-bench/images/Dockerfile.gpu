# --------------------------------------------------------------------------
#  Dockerfile.gpu — GPU memory checkpoint/restore benchmark image
#
#  PyTorch + the multi-GPU tensor test server + NVIDIA's cuda-checkpoint
#  utility.  gVisor's native CUDA checkpoint integration
#  (runsc checkpoint --cuda-checkpoint-path=/usr/local/bin/cuda-checkpoint)
#  execs cuda-checkpoint INSIDE the container, so the binary must be baked
#  into the image.
#
#  No LD_PRELOAD / libgcr — the sentry drives the GPU checkpoint natively.
#
#  Build context: cr-bench/
#  Build:  docker build -t cr-bench-gpu -f images/Dockerfile.gpu .
# --------------------------------------------------------------------------
FROM nvidia/cuda:12.6.3-base-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir --upgrade pip

# PyTorch (CUDA 12.6 wheels)
RUN pip3 install --no-cache-dir \
        torch --index-url https://download.pytorch.org/whl/cu126

# Newer NCCL than torch's bundled one, for ncclCommSuspend/ncclCommResume
# (2.30+). Upgrades libnccl.so.2 in place; the NCCL ABI is stable so torch
# uses it too.
RUN pip3 install --no-cache-dir -U nvidia-nccl-cu12==2.30.7

# NVIDIA cuda-checkpoint utility (thin CLI over cuCheckpoint* driver APIs).
# Requires host driver >= R550; >= R570 recommended for multi-process/IPC.
# (No build-time smoke test: the binary links libcuda.so.1, which is only
#  injected at runtime with the rest of the driver userspace.)
RUN curl -fSL -o /usr/local/bin/cuda-checkpoint \
        https://github.com/NVIDIA/cuda-checkpoint/raw/main/bin/x86_64_Linux/cuda-checkpoint \
    && chmod 0755 /usr/local/bin/cuda-checkpoint

RUN mkdir -p /app
COPY apps/gpu_mem_server.py /app/gpu_mem_server.py
COPY apps/nccl_repro.py /app/nccl_repro.py
COPY apps/cuda_churn.py /app/cuda_churn.py

# GPU memory settings (can be overridden at runtime)
ENV GPU_MEM_MB=512
ENV NUM_TENSORS=4
ENV PORT=8199

WORKDIR /app
EXPOSE 8199

ENTRYPOINT ["python3", "/app/gpu_mem_server.py"]
